<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Nexus Jobs</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar">
        <a href="/" class="nav-brand">Nexus Jobs</a>
        <div class="links">
            <a href="/register" class="btn">SignUp</a>
        </div>
    </nav>
    <div class="container" style="display: flex; align-items: center; justify-content: center;">
        <div class="glass-card auth-container" style="width: 100%;">
            <h2 style="text-align: center; margin-bottom: 2rem;">Welcome Back</h2>
            <div th:if="${param.error}" style="color: var(--danger); text-align: center; margin-bottom: 1rem;">
                Invalid username and password.
            </div>
            <div th:if="${param.registered}" style="color: var(--accent); text-align: center; margin-bottom: 1rem;">
                Registration successful! Please login.
            </div>
            <div th:if="${param.logout}" style="color: var(--text-muted); text-align: center; margin-bottom: 1rem;">
                You have been logged out.
            </div>
            <form th:action="@{/login}" method="post">
                <div class="form-group">
                    <label for="username">Username</label>
                    <input type="text" id="username" name="username" class="form-control" required autofocus>
                </div>
                <div class="form-group">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" class="form-control" required>
                </div>
                <button type="submit" class="btn" style="width: 100%;">Log in</button>
            </form>
            <p style="text-align: center; margin-top: 1.5rem; color: var(--text-muted);">
                Don't have an account? <a href="/register" style="color: var(--primary);">Sign up</a>
            </p>
        </div>
    </div>
    <div th:replace="~{fragments/chatbot :: chatbot}"></div>
</body>
</html>
